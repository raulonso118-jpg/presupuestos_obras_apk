import numpy as np
import json, os, time
from datetime import datetime
import openpyxl
from openpyxl.styles import Font, PatternFill, Alignment, Border, Side

DTYPE_INT = np.int8

class NVNB_HabitosObra:
    def __init__(self, depth=500):
        self.depth = depth
        self.file_weights = "nvnb_obras_mtj.npy"
        self.file_mapa = "nvnb_obras_mapa.json"
        self.mapa_vocal, self.mapa_inverso = self._cargar_mapa()
        self.W_rrv = self._cargar_pesos()

    def _cargar_mapa(self):
        if os.path.exists(self.file_mapa):
            try:
                import json
                with open(self.file_mapa, 'r', encoding='utf-8') as f:
                    mapa = json.load(f)
                return mapa, {int(v): k for k, v in mapa.items()}
            except: pass
        return {"<NULL>": 0}, {0: "<NULL>"}
    def _cargar_pesos(self):
        if os.path.exists(self.file_weights):
            try:
                pesos = np.load(self.file_weights)
                if pesos.shape == (3, self.depth, self.depth):
                    return [pesos[i] for i in range(3)]
            except: pass
        return [np.zeros((self.depth, self.depth), dtype=DTYPE_INT) for _ in range(3)]

    def aprender_asociacion(self, clave, valor_str):
        tokens = [clave.lower(), valor_str.lower()]
        for token in tokens:
            if token not in self.mapa_vocal:
                for i in range(1, self.depth):
                    if i not in self.mapa_inverso:
                        idx = i
                        self.mapa_vocal[token] = idx
                        self.mapa_inverso[idx] = token
                        break
        idx_pre = self.mapa_vocal[tokens[0]]
        idx_act = self.mapa_vocal[tokens[1]]
        for W in self.W_rrv:
            if W[idx_pre, idx_act] < 1:
                W[idx_pre, idx_act] += 1

    def predecir_habito(self, clave):
        idx = self.mapa_vocal.get(clave.lower(), 0)
        if idx == 0: return None
        votos = np.zeros(self.depth, dtype=int)
        for W in self.W_rrv:
            votos += W[idx, :]
        best_idx = np.argmax(votos)
        if votos[best_idx] > 0:
            return self.mapa_inverso.get(best_idx)
        return None

    def guardar(self):
        np.save(self.file_weights, np.array(self.W_rrv, dtype=DTYPE_INT))
        with open(self.file_mapa, 'w', encoding='utf-8') as f:
            json.dump(self.mapa_vocal, f, ensure_ascii=False, indent=4)

def generar_excel_arquitecto(datos, nombre_archivo="Presupuesto_Arquitecto.xlsx"):
    wb = openpyxl.Workbook()
    ws = wb.active
    ws.title = "Presupuesto"

    header_font = Font(name="Calibri", size=11, bold=True, color="FFFFFF")
    header_fill = PatternFill(start_color="1F4E79", end_color="1F4E79", fill_type="solid")
    sub_fill = PatternFill(start_color="D9E1F2", end_color="D9E1F2", fill_type="solid")
    bold_font = Font(name="Calibri", size=11, bold=True)
    money_font = Font(name="Calibri", size=11, bold=True)
    thin_border = Border(left=Side(style='thin'), right=Side(style='thin'), top=Side(style='thin'), bottom=Side(style='thin'))

    # Membrete
    ws.merge_cells("A1:D1")
    ws["A1"] = f"PRESUPUESTO DE OBRA - {datos['cliente'].upper()}"
    ws["A1"].font = Font(name="Calibri", size=14, bold=True, color="1F4E79")
    ws["A1"].alignment = Alignment(horizontal="center")
    ws.append(["Obra:", datos['obra'], "Fecha:", datos['fecha']])
    ws.append(["Elaboró:", datos['elaboro'], "Folio:", datos['folio']])
    ws.append([])

    filas = [
        ["CONCEPTO", "CANTIDAD", "UNIDAD", "IMPORTE"],
        ["Área total de muro", datos["area_m2"], "m²", "-"],
        ["MATERIALES REQUERIDOS", "", "", ""],
        ["Block 12x20x40 (incluye 5% merma)", datos["piezas_block"], "Pzas", "-"],
        ["Cemento Gris 50kg", datos["sacos_cemento"], "Sacos", "-"],
        ["Arena mina", datos["m3_arena"], "m³", "-"],
        ["Varilla 3/8 (tramo 6m)", datos["tramos_varilla"], "Tramos", "-"],
        ["Alambre recocido", datos["kg_alambre"], "kg", "-"],
        ["MANO DE OBRA Y COSTOS", "", "", ""],
        ["Días estimados", datos["dias_trabajo"], "Días", ""],
        ["Pago diario peón", f"${datos['pago_peon_diario']:,.2f}", "MXN/día", f"${datos['gasto_total_peones']:,.2f}"],
        ["Cobro mano de obra (sin impuestos)", f"${datos['cobro_m2_unit']:,.2f} x m²", "MXN", f"${datos['subtotal_mo']:,.2f}"],
        ["", "", "", ""],
        ["RESUMEN FINANCIERO", "", "", ""],
        ["Subtotal mano de obra", "", "", f"${datos['subtotal_mo']:,.2f}"],
        [f"Utilidad ({datos['pct_utilidad']}%)", "", "", f"${datos['monto_utilidad']:,.2f}"],
        ["Subtotal + Utilidad", "", "", f"${datos['subtotal_mas_utilidad']:,.2f}"],
        [f"IVA ({datos['pct_iva']}%) - SEPARADO", "", "", f"${datos['monto_iva']:,.2f}"],
        ["TOTAL CON IVA", "", "", f"${datos['total_con_iva']:,.2f}"],
        ["", "", "", ""],
        ["GANANCIA NETA MAESTRO (sin IVA)", "", "", f"${datos['ganancia_neta']:,.2f}"],
    ]

    start_row = ws.max_row + 1
    for fila in filas:
        ws.append(fila)

    for r in range(start_row, ws.max_row + 1):
        concepto = ws.cell(row=r, column=1).value
        if concepto in ["CONCEPTO", "MATERIALES REQUERIDOS", "MANO DE OBRA Y COSTOS", "RESUMEN FINANCIERO"]:
            for c in range(1,5):
                cell = ws.cell(row=r, column=c)
                cell.font = header_font if concepto == "CONCEPTO" else bold_font
                cell.fill = header_fill if concepto == "CONCEPTO" else sub_fill
                cell.border = thin_border
        else:
            for c in range(1,5):
                cell = ws.cell(row=r, column=c)
                cell.border = thin_border
                if "IVA" in str(concepto) and c==4:
                    cell.font = Font(bold=True, color="FF0000", size=11)
                if "TOTAL CON IVA" in str(concepto) and c==4:
                    cell.font = Font(bold=True, color="006100", size=12)

    ws.column_dimensions['A'].width = 38
    ws.column_dimensions['B'].width = 18
    ws.column_dimensions['C'].width = 15
    ws.column_dimensions['D'].width = 22
    wb.save(nombre_archivo)
    return nombre_archivo

def ejecutar_asistente_arquitecto():
    nvnb = NVNB_HabitosObra()
    print("=== NVNB-OBRA v1.0 ARQUITECTO ===")
    peon_sug = nvnb.predecir_habito("peon") or "400"
    m2_sug = nvnb.predecir_habito("costo_m2") or "380"
    print(f"[NVNB] Peón habitual: ${peon_sug} | m² habitual: ${m2_sug}")

    cliente = input("Cliente: ") or "Cliente General"
    obra = input("Nombre de la obra: ") or "Barda Perimetral"
    elaboro = input("Elaboró: ") or "Raúl Alonso - NVNB"
    m_largos = float(input("Metros largo: ") or "10")
    alto = float(input("Altura (m): ") or "2.5")
    peon_str = input(f"Pago peón [${peon_sug}]: ").strip() or peon_sug
    m2_str = input(f"Cobro m² [${m2_sug}]: ").strip() or m2_sug

    pct_utilidad = float(input("Utilidad % [15]: ") or "15")
    pct_iva = float(input("IVA % [16]: ") or "16")

    nvnb.aprender_asociacion("peon", peon_str)
    nvnb.aprender_asociacion("costo_m2", m2_str)
    nvnb.guardar()

    area_m2 = m_largos * alto
    piezas_block = area_m2 * 12.5 * 1.05
    sacos_cemento = area_m2 * 0.22
    m3_arena = area_m2 * 0.025
    num_castillos = int(m_largos / 2.5) + 1
    metros_varilla = num_castillos * (alto + 0.5) * 4
    tramos_varilla = metros_varilla / 6.0
    kg_alambre = tramos_varilla * 0.5
    dias_trabajo = area_m2 / 7.0

    costo_peon = float(peon_str)
    cobro_m2 = float(m2_str)
    gasto_total_peones = dias_trabajo * costo_peon
    subtotal_mo = area_m2 * cobro_m2
    monto_utilidad = subtotal_mo * (pct_utilidad/100)
    subtotal_mas_utilidad = subtotal_mo + monto_utilidad
    monto_iva = subtotal_mas_utilidad * (pct_iva/100)
    total_con_iva = subtotal_mas_utilidad + monto_iva
    ganancia_neta = subtotal_mo - gasto_total_peones

    datos = {
        "cliente": cliente, "obra": obra, "elaboro": elaboro,
        "fecha": datetime.now().strftime("%d/%m/%Y"),
        "folio": f"NVNB-{int(time.time())%10000}",
        "area_m2": round(area_m2,2),
        "piezas_block": int(piezas_block),
        "sacos_cemento": round(sacos_cemento,1),
        "m3_arena": round(m3_arena,2),
        "tramos_varilla": round(tramos_varilla,1),
        "kg_alambre": round(kg_alambre,1),
        "dias_trabajo": round(dias_trabajo,1),
        "pago_peon_diario": costo_peon,
        "cobro_m2_unit": cobro_m2,
        "subtotal_mo": round(subtotal_mo,2),
        "gasto_total_peones": round(gasto_total_peones,2),
        "pct_utilidad": pct_utilidad,
        "monto_utilidad": round(monto_utilidad,2),
        "subtotal_mas_utilidad": round(subtotal_mas_utilidad,2),
        "pct_iva": pct_iva,
        "monto_iva": round(monto_iva,2),
        "total_con_iva": round(total_con_iva,2),
        "ganancia_neta": round(ganancia_neta,2)
    }

    archivo = generar_excel_arquitecto(datos)
    print(f"\n¡Listo! Archivo: {archivo}")
    print(f"Subtotal: ${datos['subtotal_mo']:,.2f} + Utilidad: ${datos['monto_utilidad']:,.2f} + IVA: ${datos['monto_iva']:,.2f} = TOTAL: ${datos['total_con_iva']:,.2f}")

if __name__ == "__main__":
    ejecutar_asistente_arquitecto()
